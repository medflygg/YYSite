# Copy to .env and fill in real values. Never commit .env.

# Admin login at /redactingpages (plain text or bcrypt hash starting with $2)
ADMIN_PASSWORD=changeme

# Optional reserved secret (not required by current auth)
SESSION_SECRET=replace-with-long-random-string

# SQLite path (relative to app root)
DATABASE_URL=file:./data/yysite.db

# Public site URL (used for Astro `site`)
SITE_URL=https://your.domain

HOST=0.0.0.0
PORT=4321
NODE_ENV=production
