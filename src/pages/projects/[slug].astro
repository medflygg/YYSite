---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery';
import {
  getProjectBySlug,
  listProjects,
  renderMarkdown,
} from '../../lib/content';

/** Static on GitHub Pages; SSR on VPS when STATIC_EXPORT is unset. */
export const prerender = import.meta.env.STATIC_EXPORT === 'true';

export async function getStaticPaths() {
  const all = await listProjects();
  return all.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/portfolio');
}

const project = await getProjectBySlug(slug);
if (!project) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const gallery =
  project.gallery.length > 0 ? project.gallery : [project.cover].filter(Boolean);
const bodyHtml = renderMarkdown(project.body);
---

<BaseLayout title={project.title} description={project.summary}>
  <article class="mx-auto max-w-[1440px] px-5 pb-16 pt-8 md:px-20">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,331px)] lg:gap-12">
      <div>
        <ProjectGallery client:load images={gallery} alt={project.title} />

        <footer
          class="mt-4 grid grid-cols-[1fr_auto_1fr] items-start gap-2 text-[15px] leading-[20px]"
        >
          <span class="min-w-0">{project.client}</span>
          <span class="text-center">{project.year}</span>
          <span class="min-w-0 text-right">{project.specs}</span>
        </footer>
      </div>

      <aside class="lg:pt-0">
        <h1 class="mb-6 text-[clamp(32px,4vw,49px)] lowercase leading-[1.1]">
          {project.title}
        </h1>
        <div class="prose-yy mb-8 text-[15px] leading-[20px]" set:html={bodyHtml} />

        {
          project.behindTheScenes.length > 0 && (
            <>
              <hr class="my-6 border-black/80" />
              <div class="text-[15px] leading-[20px]">
                <p class="mb-1 underline underline-offset-2">что осталось за кадром:</p>
                <ul>
                  {project.behindTheScenes.map((item) => (
                    <li>– {item}{item.endsWith(';') || item.endsWith('.') ? '' : ';'}</li>
                  ))}
                </ul>
              </div>
            </>
          )
        }

        {
          project.whatHappenedNext.length > 0 && (
            <>
              <hr class="my-6 border-black/80" />
              <div class="text-[15px] leading-[20px]">
                <p class="mb-1 underline underline-offset-2">что было дальше:</p>
                <ul>
                  {project.whatHappenedNext.map((item) => (
                    <li>– {item}</li>
                  ))}
                </ul>
              </div>
            </>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>
