---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const gallery =
  data.gallery.length > 0 ? data.gallery : [data.cover].filter(Boolean);
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="mx-auto max-w-[1440px] px-5 pb-16 pt-8 md:px-20">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(280px,331px)] lg:gap-12">
      <div>
        <ProjectGallery client:load images={gallery} alt={data.title} />

        {/* Мета под картинкой: формат по правому краю изображения */}
        <footer
          class="mt-4 grid grid-cols-[1fr_auto_1fr] items-start gap-2 text-[15px] leading-[20px]"
        >
          <span class="min-w-0">{data.client}</span>
          <span class="text-center">{data.year}</span>
          <span class="min-w-0 text-right">{data.specs}</span>
        </footer>
      </div>

      <aside class="lg:pt-0">
        <h1 class="mb-6 text-[clamp(32px,4vw,49px)] lowercase leading-[1.1]">
          {data.title}
        </h1>
        <div class="prose-yy mb-8 text-[15px] leading-[20px]">
          <Content />
        </div>

        {
          data.behindTheScenes.length > 0 && (
            <>
              <hr class="my-6 border-black/80" />
              <div class="text-[15px] leading-[20px]">
                <p class="mb-1 underline underline-offset-2">что осталось за кадром:</p>
                <ul>
                  {data.behindTheScenes.map((item) => (
                    <li>– {item}{item.endsWith(';') || item.endsWith('.') ? '' : ';'}</li>
                  ))}
                </ul>
              </div>
            </>
          )
        }

        {
          data.whatHappenedNext.length > 0 && (
            <>
              <hr class="my-6 border-black/80" />
              <div class="text-[15px] leading-[20px]">
                <p class="mb-1 underline underline-offset-2">что было дальше:</p>
                <ul>
                  {data.whatHappenedNext.map((item) => (
                    <li>– {item}</li>
                  ))}
                </ul>
              </div>
            </>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>
