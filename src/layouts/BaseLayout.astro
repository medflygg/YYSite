---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  showIntro?: boolean;
}

const {
  title = 'YY',
  description = 'Проектирую книги, журналы и визуальные системы',
  showIntro = false,
} = Astro.props;

const pageTitle = title === 'YY' ? 'YY — портфолио' : `${title} — YY`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {
      showIntro && (
        <>
          <style is:inline>
            #yy-intro-boot {
              position: fixed;
              inset: 0;
              z-index: 10000;
              overflow: hidden;
              background: #f8f6f1;
              opacity: 1;
              visibility: visible;
              pointer-events: auto;
              transition:
                opacity 0.65s ease-in-out,
                visibility 0.65s ease-in-out;
            }
            #yy-intro-boot.is-out {
              opacity: 0;
              visibility: hidden;
              pointer-events: none;
            }
            html[data-yy-intro='skip'] #yy-intro-boot {
              display: none !important;
            }
          </style>
          <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
            (function () {
              function stripBase(pathname) {
                var base = String(baseUrl || '/').replace(/\/+$/, '');
                var path = pathname.replace(/\/+$/, '') || '/';
                if (base && path.indexOf(base) === 0) {
                  path = path.slice(base.length) || '/';
                }
                return path;
              }
              function shouldPlay() {
                try {
                  var ref = document.referrer;
                  if (!ref) return true;
                  var refUrl = new URL(ref);
                  if (refUrl.origin !== window.location.origin) return true;
                  return stripBase(refUrl.pathname) === '/';
                } catch (e) {
                  return true;
                }
              }

              if (!shouldPlay()) {
                document.documentElement.dataset.yyIntro = 'skip';
                return;
              }

              document.documentElement.dataset.yyIntro = '1';

              function removeBoot(boot) {
                if (window.__yyIntroGone) return;
                window.__yyIntroGone = true;
                if (boot) boot.remove();
                delete document.documentElement.dataset.yyIntro;
              }

              /** Плавный fade-out, потом удаление из DOM */
              function dismiss() {
                var boot = document.getElementById('yy-intro-boot');
                if (!boot || boot.classList.contains('is-out')) return;

                boot.classList.add('is-out');

                var done = false;
                function finish() {
                  if (done) return;
                  done = true;
                  removeBoot(boot);
                }

                boot.addEventListener(
                  'transitionend',
                  function (e) {
                    if (e.propertyName === 'opacity') finish();
                  },
                  { once: true },
                );
                window.setTimeout(finish, 750);
              }

              window.__yyDismissIntro = dismiss;

              window.setTimeout(dismiss, 2400);

              function bindClick() {
                var boot = document.getElementById('yy-intro-boot');
                if (boot) boot.addEventListener('click', dismiss, { once: true });
              }
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bindClick, { once: true });
              } else {
                bindClick();
              }

              window.addEventListener('pageshow', function (e) {
                if (!e.persisted) return;
                var boot = document.getElementById('yy-intro-boot');
                removeBoot(boot);
              });
            })();
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-screen bg-yy-cream text-yy-black antialiased">
    {
      showIntro && (
        <div id="yy-intro-boot" aria-hidden="true">
          <img
            src={withBase('/images/loader-vector-1.svg')}
            alt=""
            class="pointer-events-none absolute -left-10 top-0 h-[140%] w-auto max-w-none opacity-90"
          />
          <img
            src={withBase('/images/loader-vector-2.svg')}
            alt=""
            class="pointer-events-none absolute -right-4 -top-10 h-[130%] w-auto max-w-none opacity-90"
          />
          <div class="relative z-10 flex h-full flex-col pt-[var(--header-height)]">
            <div
              class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-6 pt-16 pb-28 text-center"
            >
              <h1
                class="yy-intro-title max-w-[520px] text-[clamp(36px,5vw,51px)] lowercase leading-[1.08] text-black"
              >
                Сначала форма,<br />Потом полка.
              </h1>
              <p
                class="invisible mt-6 max-w-[405px] text-[15px] leading-[20px] lowercase"
                aria-hidden="true"
              >
                Проектирую книги, журналы<br />и визуальные системы
              </p>
            </div>
          </div>
        </div>
      )
    }
    <Header />
    <main class="relative">
      <slot />
    </main>
  </body>
</html>
