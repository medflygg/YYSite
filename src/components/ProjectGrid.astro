---
import { typograf } from '../lib/typograf';

interface ProjectCard {
  id: string;
  title: string;
  href: string;
  cover: string;
  caption: string;
}

interface Props {
  projects: ProjectCard[];
}

const { projects } = Astro.props;
---

{/*
  Mobile (Figma): одна колонка, карточка 342×484, подпись по центру 12px.
  Desktop: 3 колонки как раньше.
*/}
<div
  class="mx-auto grid max-w-[1280px] grid-cols-1 gap-x-6 gap-y-8 px-[30px] py-8 md:grid-cols-3 md:gap-y-10 md:px-20 md:py-14"
>
  {
    projects.map((project) => (
      <a href={project.href} class="group mx-auto block w-full max-w-[342px] md:mx-0 md:max-w-none">
        <div class="aspect-[342/484] overflow-hidden bg-yy-cream md:aspect-[411/581] md:bg-black">
          {project.cover ? (
            <img
              src={project.cover}
              alt={project.title}
              class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.03]"
            />
          ) : null}
        </div>
        <p
          class="mt-3 max-w-none text-center text-[12px] leading-[18px] whitespace-pre-line md:mt-4 md:max-w-[293px] md:text-left md:text-[15px] md:leading-[21px]"
        >
          {typograf(project.caption)}
        </p>
      </a>
    ))
  }
</div>
